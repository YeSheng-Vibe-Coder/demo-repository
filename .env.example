# Copy to .env.local and fill in your own values. .env.local is ignored by Git and must never be committed.

# NVIDIA API key (https://build.nvidia.com) for the agents: investigators, senior investigator,
# risk grading agent and rule update agent. Needed for live investigation and for every learning command.
NVIDIA_API_KEY=

# Zetaris REST access to the IBM HI-Large data (for example through an SSH tunnel to your own VM).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=

# Optional: send the investigators to a self-hosted Nemotron Lightning (e.g. the Colab notebook in deploy/colab).
# AML_INVESTIGATOR_BASE_URL=
# AML_INVESTIGATOR_MODEL=
# AML_INVESTIGATOR_KEY=
# AML_INVESTIGATOR_RPM=
